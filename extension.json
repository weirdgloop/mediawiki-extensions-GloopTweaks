{
	"name": "GloopTweaks",
	"version": "1.2.0",
	"author": [
		"[https://github.com/jayktaylor Jayden Bailey]",
		"TehKittyCat",
		"..."
	],
	"url": "https://weirdgloop.org",
	"descriptionmsg": "glooptweaks-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"MessagesDirs": {
		"Analytics": [
			"i18n/analytics"
		],
		"WeirdGloopContactMessages": [
			"i18n/contact"
		],
		"WeirdGloopMessages": [
			"i18n/weirdgloop"
		],
		"WeirdGloopOverrides": [
			"i18n/weirdgloopoverrides"
		],
		"WeirdGloopProjectNames": [
			"i18n/projectnames"
		],
		"WeirdGloopTemporaryMessages": [
			"i18n/temporary"
		]
	},
	"requires": {
		"MediaWiki": ">= 1.45.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\GloopTweaks\\": "includes/"
	},
	"ContentHandlers": {
		"GeoJSON": "MediaWiki\\Extension\\GloopTweaks\\ContentHandler\\GeoJSON",
		"interactivemap": "MediaWiki\\Extension\\GloopTweaks\\ContentHandler\\InteractiveMap"
	},
	"ResourceModules": {
		"wg.fixedwidth": {
			"class": "MediaWiki\\Extension\\GloopTweaks\\ResourceLoader\\FixedWidthStyleModule"
		}
	},
	"AuthManagerAutoConfig": {
		"preauth": {
			"MediaWiki\\Extension\\GloopTweaks\\StopForumSpam\\GloopPreAuthenticationProvider": {
				"class": "MediaWiki\\Extension\\GloopTweaks\\StopForumSpam\\GloopPreAuthenticationProvider",
				"sort": 5
			}
		}
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\GloopTweaks\\GloopTweaksHooks",
			"services": [
				"MainConfig"
			]
		}
	},
	"Hooks": {
		"AfterImportPage": "main",
		"ArticleViewHeader": "main",
		"BeforePageDisplay": "main",
		"ContactForm": "main",
		"GetLocalURL::Internal": "main",
		"LocalFilePurgeThumbnails": "main",
		"MessageCacheFetchOverrides": "main",
		"OpenSearchUrls": "main",
		"PageDeleteComplete": "main",
		"PageMoveComplete": "main",
		"PageSaveComplete": "main",
		"PageUndeleteComplete": "main",
		"ResourceLoaderRegisterModules": "main",
		"ScribuntoExternalLibraries": "main",
		"SkinAddFooterLinks": "main",
		"SkinCopyrightFooterMessage": "main",
		"TestCanonicalRedirect": "main",
		"TitleSquidURLs": "main",
		"UploadForm:initial": "main",
		"UserGetRightsRemove": "main",
		"getUserPermissionsErrors": "main",
		"RawPageViewBeforeOutput": "main",
		"APIAfterExecute": "main",
		"ContentAlterParserOutput": "main",
		"ResourceLoaderBeforeResponse": "main"
	},
	"JobClasses": {
		"refreshLinksBatch": "MediaWiki\\Extension\\GloopTweaks\\RefreshLinksBatchJob"
	},
	"config_prefix": "wgGloopTweaks",
	"config": {
		"AddFooterLinks": {
			"value": true
		},
		"AnalyticsID": {
			"value": ""
		},
		"FamilyCentralDB": {
			"value": false,
			"description": "The database name of the central wiki in the family. Typically, this is something like en_rswiki."
		},
		"NetworkCentralDB": {
			"value": false,
			"description": "The database name of the Weird Gloop central wiki, which is metawiki, but can be changed."
		},
		"CacheTagDebug": {
			"value": false
		},
		"CFPurgerRedisConfig": {
			"value": []
		},
		"CFPurgerRedisServer": {
			"value": ""
		},
		"CFToken": {
			"value": ""
		},
		"CFZone": {
			"value": ""
		},
		"CSP": {
			"value": ""
		},
		"CSPAnons": {
			"value": ""
		},
		"EnableContactFilter": {
			"value": true
		},
		"EnableTheming": {
			"value": true
		},
		"EnableLoadingFixedWidth": {
			"value": true
		},
		"EnableMessageOverrides": {
			"value": true
		},
		"EnableMobileVariant": {
			"value": true
		},
		"EnableStructuredData": {
			"value": true
		},
		"NoRobots": {
			"value": false
		},
		"ProtectSiteInterface": {
			"value": true
		},
		"RequireLicensesToUpload": {
			"value": true
		},
		"SendDetailsWithContactPage": {
			"value": true
		},
		"SensitiveRights": {
			"value": []
		},
		"SitemapsCompressed": {
			"value": true
		},
		"SitemapsFileBackend": {
			"value": null
		},
		"Themes": {
			"value": [
				"dark",
				"light"
			]
		},
		"UseSFS": {
			"value": true
		},
		"DefaultTheme": {
			"value": "light",
			"description": "The name of the theme being used as this wiki's default. {skin}.css will be loaded instead of {skin}-theme-{theme}.css when this theme is enabled."
		}
	},
	"AvailableRights": [
		"editinterfacesite",
		"bypassgloopspam"
	],
	"manifest_version": 2
}
